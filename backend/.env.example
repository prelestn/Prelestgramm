# База данных (Railway автоматически предоставляет DATABASE_URL)
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/prelestgram

# Redis (Railway автоматически предоставляет REDIS_URL)
REDIS_URL=redis://localhost:6379

# Telegram Bot Token (от @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID чата администратора в Telegram (узнать у @userinfobot)
ADMIN_CHAT_ID=123456789

# Секрет для подписи JWT (сгенерировать: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=your_jwt_secret_here

# MinIO (объектное хранилище для медиа)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=prelestgram
